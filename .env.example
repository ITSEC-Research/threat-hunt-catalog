# Backend Configuration
VITE_BACKEND_URL=http://localhost:8080
VITE_BACKEND_PORT=8080

# OpenSearch Configuration
VITE_OPENSEARCH_URL=http://localhost:9200
VITE_OPENSEARCH_USERNAME=admin
VITE_OPENSEARCH_PASSWORD=password

# Pagination
VITE_RULES_PER_PAGE=25

# Time Window Options (comma-separated, format: value:label)
VITE_TIME_WINDOWS=6h:6 Hours,1d:1 Day,3d:3 Days,1w:1 Week,1m:1 Month

# Default Time Window
VITE_DEFAULT_TIME_WINDOW=1d

# Sigma Rules Directory (relative to project root)
VITE_SIGMA_DIR=sigma

# Output File (relative to project root)
VITE_OUTPUT_FILE=src/detectionRulesData.js

# Conversion Settings
VITE_SIGMA_TARGET=opensearch_lucene
VITE_SIGMA_FORMAT=dsl_lucene
